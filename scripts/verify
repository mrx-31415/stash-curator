#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")/.."

pytest() (
  local base temporary
  base="${TMPDIR:-../.tmp}"
  mkdir -p "$base"
  temporary=$(mktemp -d "$base/pytest-curator.XXXXXX")
  trap 'rm -rf "$temporary"' EXIT
  uv run --frozen pytest -q --basetemp="$temporary" "$@"
)

pytest_not_integration() (
  pytest -m "not integration" "$@"
)

# ── compiled core (Go) ─────────────────────────────────────────────────
# Go is a dev/build dependency only; the shipped plugin never needs it (the
# binary is optional acceleration, the pure-Python fallback stays intact).
# A missing Go toolchain skips the core checks; a failing build fails the run.
core_build_and_check() {
  if ! command -v go >/dev/null 2>&1; then
    echo "[verify] go toolchain not found; skipping compiled-core checks (the full gate and plugin packaging require Go)" >&2
    return 0
  fi
  scripts/build_core.sh
  ( cd core && go vet ./... && go test ./... )
}

# Differential gate: the binary must reproduce the numpy stage outputs within
# tolerance on seeded synthetic corpora. CURATOR_CORE pins the built binary.
core_gate() {
  if [[ ! -x "core/bin/curator-core" ]]; then
    core_build_and_check
  fi
  CURATOR_CORE="$(pwd)/core/bin/curator-core" pytest tests/core tests/model/test_core.py
}

case "${1:-}" in
  changed)
    shift
    mapfile -d '' files < <(
      { git diff --name-only -z --diff-filter=ACMR; git diff --cached --name-only -z --diff-filter=ACMR; git ls-files --others --exclude-standard -z; } |
        sort -zu
    )
    python=()
    javascript=false
    core_changed=false
    for file in "${files[@]}"; do
      [[ -f "$file" ]] || continue
      [[ "$file" == *.py ]] && python+=("$file")
      [[ "$file" == plugin/stash-curator.js ]] && javascript=true
      [[ "$file" == core/* ]] && core_changed=true
    done
    # Regenerate the scoring fingerprint before building: the Go binary embeds
    # the constant, so a stale one would be compiled into the parity run.
    uv run --frozen python scripts/scoring_fingerprint.py --write >/dev/null
    if [[ "$core_changed" == true ]]; then
      core_build_and_check
      core_gate
    fi
    ((${#python[@]} == 0)) || uv run --frozen ruff format "${python[@]}"
    ((${#python[@]} == 0)) || uv run --frozen ruff check "${python[@]}"
    [[ "$javascript" == false ]] || node --check plugin/stash-curator.js
    (($# == 0)) || pytest_not_integration "$@"
    git diff --check
    ;;
  core)
    core_build_and_check
    core_gate
    ;;
  perf)
    core_build_and_check
    uv run --frozen python scripts/perf_gate.py
    ;;
  full)
    # Fails rather than rewrites: a stale constant means the digest does not
    # identify the code, and CI must not paper over that by mutating the tree.
    uv run --frozen python scripts/scoring_fingerprint.py --check
    core_build_and_check
    uv run --frozen ruff check .
    uv run --frozen ruff format --check .
    uv run --frozen mypy curator plugin/backend.py
    # Build the archive before pytest so the packaging/archive tests validate
    # the zip this run produces, not a stale one.
    uv run --frozen python scripts/build_plugin.py
    # One pytest pass with the built binary pinned. core_gate's test set
    # (tests/core + tests/model/test_core.py) is a subset of the full
    # non-integration suite, so running both doubled the core tests; the
    # env-sensitive resolver tests shadow CURATOR_CORE per-test, so a global
    # pin does not change their behavior.
    CURATOR_CORE="$(pwd)/core/bin/curator-core" pytest_not_integration
    # Perf budget: CI-shape synthetic model build within the checked-in
    # baseline x PERF_BUDGET_MULTIPLIER.
    uv run --frozen python scripts/perf_gate.py
    node --check plugin/stash-curator.js
    git diff --check
    ;;
  integration)
    # ── build plugin ──
    uv run --frozen python scripts/build_plugin.py
    compose_file="tests/integration/docker-compose.yml"
    plugin_dir="/tmp/stash-curator-integration/plugins/stash-curator"
    mkdir -p "$plugin_dir"
    unzip -oq dist/stash-curator.zip -d "$plugin_dir"
    # copy config
    cp tests/integration/stash-config.yml /tmp/stash-curator-integration/config.yml
    # ── start stash ──
    cleanup() {
      echo "[verify] tearing down Stash …"
      cd "$(dirname "$0")/.."
      STASH_CONFIG=/tmp/stash-curator-integration \
        docker compose -f "$compose_file" down --volumes 2>/dev/null || true
    }
    trap cleanup EXIT
    echo "[verify] starting Stash …"
    STASH_CONFIG=/tmp/stash-curator-integration \
      docker compose -f "$compose_file" up -d --wait
    # The sidecar database and its artifact directory are created inside the container as
    # root in WAL mode. Host tests read it read-only, and a WAL read needs to create the
    # -shm file, so the data directory must be writable by the test user. Reset it with a
    # root container every run so the integration environment starts from a clean sidecar
    # instead of leftover state, including root-owned artifact subdirectories.
    echo "[verify] resetting Curator sidecar …"
    docker run --rm -v "$plugin_dir":/plugin stashapp/stash:latest \
      sh -c 'rm -rf /plugin/data && mkdir -p /plugin/data && chmod 777 /plugin/data'
    # ── seed ──
    echo "[verify] seeding data …"
    STASH_URL="${STASH_URL:-http://localhost:9999}"
    uv run --frozen python tests/integration/seed.py --stash-url "$STASH_URL"
    # ── run playwright tests ──
    echo "[verify] running integration tests …"
    uv run --group integration --frozen pytest tests/integration/ -m integration -v \
      --base-url "$STASH_URL" \
      --video=retain-on-failure \
      --screenshot=only-on-failure \
      --output=/tmp/stash-curator-integration-test-output
    ;;
  *)
    echo "usage: scripts/verify {changed [pytest-target ...]|core|perf|full|integration}" >&2
    exit 2
    ;;
esac
