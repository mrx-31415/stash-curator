#!/usr/bin/env bash
# Check commit messages on the current branch against Conventional Commits.
# Run without arguments to check all commits since branching from main,
# or pass a single commit SHA to check just that one.
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

PATTERN='^(feat|fix|perf|docs|style|refactor|test|chore|ci|build|revert)(\(.+\))?: .+'

base="${1:-origin/main}"
if ! git rev-parse "$base" >/dev/null 2>&1; then
    base="main"
fi
check_ref="${base}..HEAD"

failures=0
while IFS= read -r line; do
    sha=$(echo "$line" | cut -d' ' -f1)
    subject=$(echo "$line" | cut -d' ' -f2-)
    if ! echo "$subject" | grep -qE "$PATTERN"; then
        echo "  FAIL  $sha $subject"
        failures=$((failures + 1))
    fi
done < <(git log --format='%h %s' "$check_ref")

if [ "$failures" -gt 0 ]; then
    echo ""
    echo "$failures commit(s) do not follow Conventional Commits."
    echo "Expected: type(scope): description"
    echo "Types: feat, fix, perf, docs, style, refactor, test, chore, ci, build, revert"
    exit 1
fi
echo "All commits follow Conventional Commits."
